resolver 127.0.0.11 valid=10s ipv6=off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name _;

    location = /nginx-health {
        access_log off;
        return 200 'ok';
    }

    location / {
        return 308 __FAE_PUBLIC_URL__$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name __FAE_DOMAIN__;

    ssl_certificate /etc/letsencrypt/live/__FAE_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__FAE_DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 55m;
    proxy_read_timeout 660s;
    proxy_send_timeout 660s;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    location /api/v1/ {
        set $backend backend:8000;
        proxy_pass http://$backend;
        proxy_buffering off;
        proxy_request_buffering off;
    }

    location /api/v1/files/upload {
        client_max_body_size 55m;
        set $backend backend:8000;
        proxy_pass http://$backend;
        proxy_request_buffering off;
        proxy_buffering off;
    }

    location /uploads/ {
        set $backend backend:8000;
        proxy_pass http://$backend;
    }

    location / {
        set $frontend frontend:3000;
        proxy_pass http://$frontend;
        proxy_buffering off;

        # location 级指令会替换继承的 proxy_set_header，因此需要重新声明。
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
