# Local Docker development. Copy to .env and replace all three secret placeholders.
# Use separate random hexadecimal values; keep an existing database's password.
DB_PASSWORD=replace_with_random_hex
JWT_SECRET_KEY=replace_with_another_random_hex
AUTH_SECRET=replace_with_another_random_hex
GOOGLE_API_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
MAX_FILE_SIZE_MB=50

# Docker service URLs, upload path and development mode are set in docker-compose.yml.
# Browser API requests use the frontend's same-origin proxy.
