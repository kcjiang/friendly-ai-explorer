# Local Docker development. Copy to .env and replace all three secret placeholders.
# Use separate random hexadecimal values; keep an existing database's password.
DB_PASSWORD=replace_with_random_hex
JWT_SECRET_KEY=replace_with_another_random_hex
AUTH_SECRET=replace_with_another_random_hex
GOOGLE_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
# Optional stable encryption secret for AI service keys. If empty, JWT_SECRET_KEY is used.
# Keep this value stable after saving keys; changing it requires re-entering saved AI keys.
AI_ENCRYPTION_KEY=
# Optional dedicated stable secret for hosted Jira account passwords.
# If empty, uses AI_ENCRYPTION_KEY, then JWT_SECRET_KEY. Keep stable after saving accounts.
TASK_ENCRYPTION_KEY=
# Administrator-controlled Jira HTTPS host allowlist, comma separated, including custom ports.
JIRA_ALLOWED_HOSTS=jira.sdmctech.com:9380
LOG_LEVEL=INFO
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
MAX_FILE_SIZE_MB=50

# Docker service URLs, upload path and development mode are set in docker-compose.yml.
# Browser API requests use the frontend's same-origin proxy.
