# Use different random hexadecimal values (at least 32 bytes) for these secrets.
# DB_PASSWORD must be URL-safe because it is embedded in DATABASE_URL.
DB_PASSWORD=replace_with_random_hex
JWT_SECRET_KEY=replace_with_another_random_hex
AUTH_SECRET=replace_with_another_random_hex
GOOGLE_API_KEY=
FAE_DATA_DIR=/opt/fae
APP_URL=http://localhost
BIND_ADDRESS=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443
IMAGE_PREFIX=ghcr.io/kcjiang/fae
IMAGE_TAG=latest
