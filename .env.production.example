# Copy to .env for local development, or .env.production for server deployment.
# Secrets: use three independent random values (32 bytes / 64 hex characters).
# Keep existing values stable when retaining the database. Never commit real secrets.
DB_PASSWORD=replace_with_random_hex
# Root for HKDF-SHA256 JWT signing and AI/platform/mail credential keys.
APP_MASTER_KEY=replace_with_another_random_hex
# Independent NextAuth session encryption key.
AUTH_SECRET=replace_with_a_third_random_hex

# Shared application settings (development and production).
LOG_LEVEL=INFO
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
MAX_FILE_SIZE_MB=50

# Server deployment settings (compose.prod.yml only; ignored by docker-compose.yml).
FAE_DATA_DIR=/opt/fae
APP_URL=http://localhost
BIND_ADDRESS=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443
IMAGE_PREFIX=ghcr.io/kcjiang/fae
IMAGE_TAG=latest

# Compose supplies database/service URLs, upload paths and environment mode.
# Browser API requests use the frontend same-origin proxy.
